# PostgreSQL
POSTGRES_USER=sas
POSTGRES_PASSWORD=sas123
POSTGRES_DB=sas_db

# Flask Backend
DATABASE_URL=postgresql://sas:sas123@postgres:5432/sas_db
JWT_SECRET=cambia-esta-clave-en-produccion
BIOMETRIC_KEY=cambia-esta-clave-biometrica-en-produccion

# Reconocimiento facial
FACIAL_DETECTOR=mtcnn
FACIAL_NITIDEZ_UMBRAL=50
FACIAL_UMBRAL_DISTANCIA=10.0
FACIAL_CACHE_TTL=60

# ─── Modo Seguro ────────────────────────────────────────────
SECURE_MODE=false

# MQTT
MQTT_HOST=sas_mosquitto
MQTT_PORT=1883
MQTT_USER=sas
MQTT_PASSWORD=sas123

# SMTP (notificaciones por correo)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=

# Frontend
FLASK_API_BASE_URL=http://backend:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Debug
DISABLE_ASYNC_DISPATCH=0
