@startuml flujo_enrolamiento_biometrico
title Enrolamiento biométrico completo

skinparam sequenceMessageAlign center
skinparam shadowing false
skinparam ParticipantPadding 15
skinparam BoxPadding 10

actor "Admin / Empleador" as Admin
actor "Trabajador" as Worker
participant "ESP32-CAM" as ESP32
queue "MQTT Broker\n(Mosquitto)" as MQTT
participant "Backend Flask\n(REST + MQTT)" as Backend
database "PostgreSQL" as DB

== Enrolamiento del dispositivo (una vez) ==
Admin -> Backend : POST /api/auth/dispositivos/generar-pin
Backend -> DB : INSERT dispositivo (enrolado=FALSE,\ncodigo_enrol=<PIN 8 caracteres>)
Backend --> Admin : PIN
Admin -> ESP32 : ingresa PIN (panel Wi-Fi del dispositivo)
ESP32 -> Backend : POST /api/auth/dispositivos/enrolar\n{pin, mac}
Backend -> DB : UPDATE dispositivo SET enrolado=TRUE,\nmac_address=<mac>
Backend --> ESP32 : 200 OK
note over ESP32 : isCloudReady() = isOnline && estaEnrolado

== Creación de persona y consentimiento ==
Admin -> Backend : POST /api/personas {rut, nombre}
Backend -> DB : INSERT persona
DB --> Backend : persona_id
Backend --> Admin : 201 Created
Admin -> Backend : POST /api/personas/<id>/consentimiento
Backend -> DB : INSERT consentimientos (persona_id)

note over Worker, ESP32 : Trabajador acude al dispositivo (ya enrolado)

== Registro de huella (AS608, 2 pasos) ==
Worker -> ESP32 : Iniciar registro (UI embebida)
ESP32 -> Worker : "Coloque dedo (1/2)"
Worker -> ESP32 : huella capturada
ESP32 -> ESP32 : generar template parcial
ESP32 -> Worker : "Coloque dedo (2/2)"
Worker -> ESP32 : huella confirmada
ESP32 -> ESP32 : validar coincidencia\n→ guardar en slot AS608 (1-127)

== Registro facial (3 fotos de referencia) ==
loop x3 (frontal + 2 perfiles)
  ESP32 -> Worker : "Mire a la cámara"
  ESP32 -> ESP32 : capturar imagen (OV2640, quality=10)
  alt primera foto
    ESP32 -> Backend : POST /api/facial/registrar\noctet-stream (JPEG) + header X-RUT
  else fotos adicionales
    ESP32 -> Backend : POST /api/facial/agregar-foto\noctet-stream (JPEG) + header X-RUT
  end
  Backend -> Backend : filtro varianza Laplaciano\n(rechaza borrosa/plana)
  Backend -> Backend : DeepFace.represent(img, modelo Facenet)\n→ embedding[128]
  Backend -> Backend : cifrar_embedding(emb)\n→ Fernet (AES-128-CBC + HMAC-SHA256)
  Backend -> DB : INSERT INTO encodings_faciales\n(persona_id, encoding=<cifrado>, foto_path)
  DB --> Backend : OK
  Backend -> ESP32 : 200 {status: ok}
end
ESP32 -> Worker : "Registro completo (3 fotos)"

@enduml
