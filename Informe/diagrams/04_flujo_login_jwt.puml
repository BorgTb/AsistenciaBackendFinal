@startuml flujo_login_jwt
title Login multi-empresa con JWT

skinparam shadowing false
skinparam sequenceMessageAlign center

actor Usuario
participant "Navegador" as Nav
participant "Next.js\n(proxy /api/*)" as Next
participant "Flask Backend" as Flask
database "PostgreSQL" as DB

Usuario -> Nav : ingresa email + password
Nav -> Next : POST /api/auth/login\n{email, password}
Next -> Flask : POST /api/auth/login (forward)
Flask -> DB : SELECT usuario WHERE email = ?\nJOIN usuario_empresa (empresas asociadas)
DB --> Flask : {id, password_hash, empresas[], rol}
Flask -> Flask : bcrypt.checkpw()

alt credenciales inválidas
  Flask --> Next : 401 Unauthorized
  Next --> Nav : mostrar error
else credenciales OK
  Flask -> Flask : generar JWT\n(user_id, empresa_id, rol, persona_id?, exp=24h)\nfirma HS256
  Flask --> Next : 200 {token, user, empresa(s)}
  Next --> Nav : Set-Cookie httpOnly + Secure\n+ redirect /dashboard
end

== Acceso posterior a endpoints protegidos ==
Nav -> Next : GET /dashboard (cookie/Authorization: Bearer <JWT>)
Next -> Flask : forward con header Authorization
Flask -> Flask : @token_required\nverifica firma + exp\n+ asigna request.user_id, empresa_id, rol
alt @requiere_rol(*roles)
  Flask -> Flask : valida request.user_rol ∈ roles
  Flask --> Next : 403 si rol insuficiente
end
Flask --> Next : 200 + datos filtrados por empresa_id
Next --> Usuario : render dashboard

@enduml
