@startuml flujo_marcaje_automatico
title Marcaje automático — centinela facial

skinparam shadowing false
skinparam sequenceMessageAlign center

participant "ESP32-CAM" as ESP32
participant "Backend Flask" as Backend
database "PostgreSQL" as DB
participant "Webhook ERP\n(Odoo/Buk/Defontana)" as ERP

loop polling continuo
  ESP32 -> ESP32 : evaluar PIR (GPIO12)
  alt presencia detectada
    ESP32 -> ESP32 : capturar imagen (OV2640, quality=10)
    ESP32 -> Backend : POST /api/facial/identificar\noctet-stream (JPEG) + header X-Device-MAC

    Backend -> Backend : filtro varianza Laplaciano\n(rechaza borrosa/plana, posible foto/pantalla)
    Backend -> Backend : DeepFace anti_spoofing=True
    Backend -> Backend : ¿embeddings en caché (FACIAL_CACHE_TTL)?
    alt caché vacía / expirada
      Backend -> DB : SELECT encoding FROM encodings_faciales\nJOIN personas WHERE activo=TRUE
      DB --> Backend : embeddings cifrados (multi-foto por persona)
      Backend -> Backend : descifrar_embedding() ∀ registro\n→ poblar caché en memoria
    end
    Backend -> Backend : comparar contra todos los embeddings\nde referencia, elegir menor distancia\n(umbral 10.0, Facenet)

    alt match encontrado
      Backend -> DB : INSERT INTO asistencias\n(persona_id, tipo, metodo='facial', fecha_hora)
      DB --> Backend : asistencia_id
      Backend --> ESP32 : 200 OK\n{persona, tipo_marcaje}
      ESP32 -> ESP32 : LED verde + mensaje en UI

      note over Backend : Thread asíncrono\n(no bloquea respuesta)
      Backend ->> Backend : Thread(target=enviar_asistencia_a_erps,\n  args=(asistencia_id,)).start()
      Backend -> DB : SELECT integraciones_erp\nWHERE envio_auto=TRUE AND activo=TRUE
      DB --> Backend : configuración + field_map
      Backend -> ERP : POST webhook (payload mapeado,\nfecha_hora en America/Santiago)
      ERP --> Backend : 200 OK
      Backend -> DB : UPDATE integraciones_erp\nSET ultimo_envio=NOW(),\n    ultimo_estado='ok'
    else sin match / calidad insuficiente
      Backend --> ESP32 : 404 {error: "no_match"}\nó 400 {error: "calidad_insuficiente"}
      ESP32 -> ESP32 : LED rojo + buzzer
    end
    Backend -> DB : INSERT INTO logs_biometricos\n(persona_id, tipo_operacion, resultado)
  end
end

@enduml
