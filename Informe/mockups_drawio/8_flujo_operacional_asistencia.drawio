<mxfile host="app.diagrams.net">
  <diagram name="Flujo operacional de asistencia" id="flujo-operacional-1">
    <mxGraphModel dx="900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="Persona frente al dispositivo&#10;(PIR detecta presencia)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="captura" value="Captura biom&#233;trica:&#10;huella (AS608) o rostro (OV2640, quality=10)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="110" width="280" height="55" as="geometry" />
        </mxCell>

        <mxCell id="dec1" value="&#191;isCloudReady()?&#10;(online + dispositivo enrolado)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="200" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="online1" value="Enviar al backend:&#10;HTTP POST /api/facial/identificar (rostro)&#10;&#243; MQTT esp32/asistencia/&lt;mac&gt; (huella)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="200" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="off1" value="Guardar marcaci&#243;n en LittleFS&#10;asistencias.json (sincronizado=false)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="off2" value="Mostrar resultado local en el panel embebido" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="415" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="dec2" value="&#191;Wi-Fi&#10;restablecido?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="495" width="200" height="85" as="geometry" />
        </mxCell>

        <mxCell id="sync" value="sincronizarPendientes():&#10;env&#237;a la cola completa al backend y la vac&#237;a" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="620" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="backend" value="Backend valida contra encodings_faciales / huella_id&#10;y registra en PostgreSQL (tabla asistencias)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="720" width="340" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dec3" value="&#191;Identificaci&#243;n&#10;exitosa?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="815" width="200" height="85" as="geometry" />
        </mxCell>

        <mxCell id="ok1" value="200 OK + Thread as&#237;ncrono&#10;(enviar_asistencia_a_erps)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="825" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ok2" value="LED verde + mensaje de &#233;xito en el dispositivo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="915" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="fail1" value="404 / 400&#10;(sin match o calidad insuficiente)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="825" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fail2" value="LED rojo + buzzer + registro en logs_biometricos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="915" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" style="endArrow=block;html=1;" edge="1" parent="1" source="start" target="captura"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;" edge="1" parent="1" source="captura" target="dec1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e3" value="S&#237;" style="endArrow=block;html=1;" edge="1" parent="1" source="dec1" target="online1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="No" style="endArrow=block;html=1;" edge="1" parent="1" source="dec1" target="off1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e5" style="endArrow=block;html=1;" edge="1" parent="1" source="off1" target="off2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=block;html=1;" edge="1" parent="1" source="off2" target="dec2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e7" value="No (reintenta AP&#10;tras 5 intentos)" style="endArrow=block;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dec2" target="off1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-30" y="540" />
              <mxPoint x="-30" y="357" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="S&#237;" style="endArrow=block;html=1;" edge="1" parent="1" source="dec2" target="sync"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e9" style="endArrow=block;html=1;" edge="1" parent="1" source="online1" target="backend"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="endArrow=block;html=1;" edge="1" parent="1" source="sync" target="backend"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e11" style="endArrow=block;html=1;" edge="1" parent="1" source="backend" target="dec3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e12" value="S&#237;" style="endArrow=block;html=1;" edge="1" parent="1" source="dec3" target="ok1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="endArrow=block;html=1;" edge="1" parent="1" source="ok1" target="ok2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e14" value="No" style="endArrow=block;html=1;" edge="1" parent="1" source="dec3" target="fail1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="endArrow=block;html=1;" edge="1" parent="1" source="fail1" target="fail2"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
