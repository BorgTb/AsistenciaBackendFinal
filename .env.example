# PostgreSQL
POSTGRES_USER=sas
POSTGRES_PASSWORD=sas123
POSTGRES_DB=sas_db

# Flask Backend
DATABASE_URL=postgresql://sas:sas123@postgres:5432/sas_db
JWT_SECRET=cambia-esta-clave-en-produccion
BIOMETRIC_KEY=cambia-esta-clave-biometrica-en-produccion

# Reconocimiento facial
FACIAL_DETECTOR=mtcnn              # mtcnn | retinaface | ssd | opencv
FACIAL_NITIDEZ_UMBRAL=50           # varianza Laplacian minima
FACIAL_UMBRAL_DISTANCIA=10.0       # distancia euclidiana maxima para match
FACIAL_CACHE_TTL=60                # segundos de cache de embeddings

# MQTT (valores por defecto para Docker)
MQTT_HOST=mosquitto
MQTT_PORT=1883

# SMTP (notificaciones por correo)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-password-app
SMTP_USE_TLS=true
MAIL_FROM=no-reply@sas.cl

# Frontend
FLASK_API_BASE_URL=http://backend:5000
