# PostgreSQL
POSTGRES_USER=sas
POSTGRES_PASSWORD=sas123
POSTGRES_DB=sas_db

# Flask Backend
DATABASE_URL=postgresql://sas:sas123@postgres:5432/sas_db
JWT_SECRET=cambia-esta-clave-en-produccion
BIOMETRIC_KEY=cambia-esta-clave-biometrica-en-produccion

# Reconocimiento facial
FACIAL_DETECTOR=mtcnn              # mtcnn | retinaface | ssd | opencv
FACIAL_NITIDEZ_UMBRAL=50           # varianza Laplacian minima
FACIAL_UMBRAL_DISTANCIA=10.0       # distancia euclidiana maxima para match
FACIAL_CACHE_TTL=60                # segundos de cache de embeddings

# ─── Modo Seguro ────────────────────────────────────────────
# false → HTTP + MQTT plano (desarrollo local)
# true  → HTTPS + MQTT con TLS (producción)
SECURE_MODE=false

# Solo se usan cuando SECURE_MODE=true:
MQTT_SSL_PORT=8883            # Puerto MQTT con TLS
MQTT_SSL_CA=./certs/ca.crt    # CA certificado para TLS
MQTT_USER=sas                 # Usuario para autenticación MQTT
MQTT_PASSWORD=                # Contraseña para autenticación MQTT
SSL_CERT_PATH=./certs/server.crt
SSL_KEY_PATH=./certs/server.key

# MQTT (valores por defecto para Docker, modo no seguro)
MQTT_HOST=mosquitto
MQTT_PORT=1883

# SMTP (notificaciones por correo)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-password-app
SMTP_USE_TLS=true
MAIL_FROM=no-reply@sas.cl

# Frontend
FLASK_API_BASE_URL=http://backend:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_DEVICE_BASE_URL=http://192.168.4.1

# Debug / Desarrollo
DISABLE_ASYNC_DISPATCH=0            # 1 para deshabilitar envio asincrono de asistencias
