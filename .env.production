# ─── PostgreSQL ───
POSTGRES_USER=sas
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
POSTGRES_DB=sas_db

# ─── Backend ───
DATABASE_URL=postgresql://sas:CAMBIA_ESTA_CONTRASENA@postgres:5432/sas_db
JWT_SECRET=CAMBIA_ESTA_CLAVE_JWT_64_CHARS_MINIMO
BIOMETRIC_KEY=CAMBIA_ESTA_CLAVE_BIOMETRICA_32_CHARS

# ─── Modo Seguro (siempre activo en producción) ───
SECURE_MODE=true
MQTT_PASSWORD=sas123
JWT_SECRET=cambia-esta-clave-en-produccion
BIOMETRIC_KEY=cambia-esta-clave-biometrica-en-produccion

# ─── Certificados SSL (usar Let's Encrypt o certificados reales) ───
# En producción NO uses los certs autofirmados de generate_certs.ps1
# Monta los certificados reales en ./certs/ o cambia estas rutas
SSL_CERT_PATH=./certs/server.crt
SSL_KEY_PATH=./certs/server.key

# ─── MQTT (modo no seguro — no se usa en producción, pero se deja por si acaso) ───
MQTT_HOST=mosquitto
MQTT_PORT=1883

# ─── SMTP ───
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-password-app
SMTP_USE_TLS=true
MAIL_FROM=no-reply@sas.cl

# ─── Facial ───
FACIAL_DETECTOR=retinaface
FACIAL_NITIDEZ_UMBRAL=50
FACIAL_UMBRAL_DISTANCIA=10.0
FACIAL_CACHE_TTL=60
